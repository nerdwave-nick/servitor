// +++ Rite of the Machine's Visage +++
//
// Re-tethers the nfluff theme, veiling the screen in a passing transition
// before and reciting the theme's own litany of awakening after. Invoking the
// visage the machine already wears changes nothing, and still answers.
//
//   servitor invoke theme porpl --reason "the night watch begins"
//   servitor invoke theme "$(printf '%s\n' default finii porpl | fuzzel --dmenu)"
//   servitor augury theme aspect
{
  "$schema": "https://raw.githubusercontent.com/nerdwave-nick/servitor/main/schema/rite.schema.json",
  "pattern": "Mark II",
  "purpose": "The visage of the machine",
  "aspects": ["default", "finii", "porpl"],
  "inscriptions": {
    "reason": {"purpose": "why the visage was changed"},
  },
  "vox-cast": ["progress", "success"],
  "subjects": [
    {
      "name": "visage",
      "designation": "tether",
      "tether": "~/.local/share/nfluff/current-theme",
      // {{aspect}} within an omen names the aspect whose omen it is, so one
      // "*" gives every aspect an anchor of its own
      "omens": {"*": "~/.config/nfluff/themes/{{aspect}}"},
      "introit": ["veil"],
      "recessional": ["awaken"],
    },
  ],
  "observances": [
    // the screen fades while the visage is exchanged; should it fail, the
    // machine merely forgoes the spectacle
    {"name": "veil", "designation": "incantation", "words": "niri msg action do-screen-transition --delay-ms 200 || true"},
    {
      // scripts/recite-hooks lies beside this rite; "~/" in an offering is
      // borne to the home of the invoker
      "name": "awaken",
      "designation": "litany",
      "scroll": "scripts/recite-hooks",
      "offerings": ["~/.config/nfluff/themes/{{aspect}}"],
      "patience": "1m",
      // should the invocation fall after the tether was rebound, the former
      // visage's litany is recited anew; the environment carries the former
      // aspect safely to the tongue
      "reversion": "test -z \"$SERVITOR_FORMER_ASPECT\" || scripts/recite-hooks ~/.config/nfluff/themes/\"$SERVITOR_FORMER_ASPECT\"",
    },
  ],
}
