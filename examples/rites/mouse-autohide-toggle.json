// +++ Rite of the Veiled Cursor +++
//
// Grants the machine spirit of niri the mercy of hiding the cursor when idle.
//
//   servitor invoke mouse-autohide-toggle on --reason "gaming remnant"
//   servitor invoke mouse-autohide-toggle off
//   servitor augury mouse-autohide-toggle mode
{
  "$schema": "https://raw.githubusercontent.com/nerdwave-nick/servitor/main/schema/rite.schema.json",
  "pattern": "Mark II",
  "purpose": "Hide the cursor after 400ms of stillness",
  "aspects": ["on", "off"],
  "inscriptions": {
    "reason": {"purpose": "why the cursor's bearing was changed"},
    "mode": {"mandatory": true, "decrees": {"on": "auto-hide", "off": "always-visible"}},
  },
  // a hotkey has no terminal: let the desktop hear of the triumph
  "vox-cast": ["success"],
  "subjects": [
    {
      "name": "cursor",
      "designation": "sanctum",
      "vessel": "~/.config/niri/util.kdl",
      "ward": "mouse-autohide",   // default: the rite's name
      "consecrate": true,         // bring util.kdl into being if it is missing
      "omens": {
        "on": ["cursor {", "    hide-after-inactive-ms 400", "}"],
        "off": "",
      },
      "recessional": ["reread"],
    },
  ],
  "observances": [
    // bid niri read its scripture anew once the sanctum changed, and grant it
    // five seconds to obey
    {"name": "reread", "designation": "incantation", "words": "niri msg action load-config-file", "patience": "5s"},
  ],
}
