// +++ Edict of the Captured Visage +++
//
// An edict bears no aspect: it is proclaimed by its name alone, and every
// proclaiming performs its whole liturgy anew.
//
//   servitor invoke screenshot                    # slurp marks the region
//   servitor invoke screenshot --region whole     # every output at once
//   servitor augury screenshot standing           # proclaimed
{
  "$schema": "https://raw.githubusercontent.com/nerdwave-nick/servitor/main/schema/rite.schema.json",
  "pattern": "Mark I",
  "purpose": "Capture the visage of the machine",
  "edict": true,
  "inscriptions": {
    // an edict's decree is one plain word, never a map of aspects
    "region": {"purpose": "\"chosen\" lets slurp mark the region, \"whole\" takes every output", "decrees": "chosen"},
  },
  "liturgy": [
    {
      "incantation": "if [ \"$SERVITOR_INSCRIPTION_REGION\" = whole ]; then grim ~/pictures/visage.png; else grim -g \"$(slurp)\" ~/pictures/visage.png; fi",
      "patience": "2m",                          // slurp waits upon your hand
      "reversion": "rm -f ~/pictures/visage.png", // strike the visage should a later verse fall
    },
    // lay the visage upon the clipboard; should this fall, the visage is struck
    {"incantation": "wl-copy --type image/png < ~/pictures/visage.png"},
    {"vox-cast": "success"},
  ],
}
