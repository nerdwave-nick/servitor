// The edict of the specification's sixteenth chapter, in pattern Mark II: a
// rite without aspects, proclaimed whole, every key an edict may bear written
// plainly.
{
  "$schema": "https://raw.githubusercontent.com/nerdwave-nick/servitor/main/schema/rite.schema.json",
  "pattern": "Mark II",
  "purpose": "Capture the visage of the machine",
  "edict": true,
  "inscriptions": {
    "region": {"purpose": "the slurp geometry", "decrees": "full"},
    "reason": {"purpose": "why the visage was taken", "mandatory": true, "decrees": "remembrance"},
  },
  "tongue": "bash",
  "vox-cast": ["progress", "success"],
  "liturgy": [
    {"designation": "incantation", "words": "grim -g \"$(slurp)\" ~/pictures/{{inscription.region}}.png",
     "patience": "2m", "reversion": "rm -f ~/pictures/{{inscription.region}}.png"},
    {"designation": "litany", "scroll": "scrolls/hymn",
     "offerings": ["~/pictures", "{{rite.name}}", "{{inscription.reason}}"], "tongue": "sh", "patience": "30s",
     "reversion": ""},
  ],
}
