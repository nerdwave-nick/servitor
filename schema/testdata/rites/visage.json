// The rite of the specification's third chapter: every key of a rite's
// scripture, its liturgy filled with one step of each kind.
{
  "pattern": "Mark I",                       // required; "Mark" + Roman numeral
  "purpose": "The visage of the machine",
  "aspects": ["default", "finii", "porpl"],  // hand-written, non-empty, unique
  "inscriptions": {
    "reason": {"purpose": "why the rite was invoked"},
    "mode":   {"mandatory": true, "decrees": {"default": "plain", "*": "ornate"}}
  },
  "auspex": "cat ~/.local/state/visage",
  "liturgy": [
    {"sanctum": "~/.config/niri/visage.kdl", "consecrate": true,
     "scripture": {"default": "", "*": {"tome": "snippets/{{aspect}}.kdl"}}},
    {"transcription": "~/.local/state/visage", "scripture": "{{aspect}}"},
    {"tether": "~/.config/foot/colors.ini", "anchor": "~/.config/foot/{{aspect}}.ini"},
    {"incantation": "pkill -USR1 foot || true"},
    {"litany": "scripts/change-theme", "offerings": ["{{aspect}}", "{{inscription.mode}}"]},
    {"vox-cast": "success"}
  ]
}
