// Every form a value of pattern Mark II may take, gathered in one rite.
{
  "$schema": "https://raw.githubusercontent.com/nerdwave-nick/servitor/main/schema/rite.schema.json",
  "pattern": "Mark II",
  "purpose": "The relics of every form",
  "aspects": ["day", "night", "void"],
  "inscriptions": {
    "reason": {"purpose": "why the relics were stirred", "mandatory": false},
    "hour": {"decrees": {"*": "dawn"}},
    "veil": {"mandatory": true, "decrees": {"*": "{{aspect}}"}},
    "omen": {"decrees": {}},
  },
  "tongue": "zsh",
  "vox-cast": ["success", "progress"],
  "subjects": [
    {"name": "a", "designation": "sanctum", "purpose": "the colours of the relics", "vessel": "~/.config/relics/a.css",
     "ward": "relics", "glyph": "/*", "closing-glyph": "*/",
     "omens": {"*": ["a {", "  color: {{aspect}};", "}"]}, "introit": ["dusk"]},
    {"name": "b", "designation": "sanctum", "vessel": "~/.config/relics/b.kdl", "glyph": "//", "closing-glyph": "",
     "consecrate": false, "omens": {"day": {"tome": "tomes/day.kdl", "illuminate": true}, "*": ""}},
    {"name": "c", "designation": "transcription", "vessel": "~/.config/relics/c",
     "omens": {"void": null, "*": ["{{aspect}}", "{{inscription.hour}}"]}, "seal": "0600", "force": true},
    {"name": "e", "designation": "transcription", "vessel": "~/.config/relics/e",
     "omens": {"day": {"tome": "tomes/e"}, "*": null}, "seal": "755", "zeal": false},
    {"name": "f", "designation": "tether", "tether": "~/.config/relics/f",
     "omens": {"void": null, "*": "~/relics/{{aspect}}"}, "zeal": true},
    {"name": "g", "designation": "machine-spirit", "omens": {"day": "bright", "*": "dim"},
     "auspex": {"scan": "cat ~/.cache/relics", "trials": {"bright": "test -e ~/.cache/bright"}, "patience": "1.5s"},
     "enact": {"bright": "touch ~/.cache/bright", "*": "rm -f ~/.cache/bright"}, "tongue": "bash",
     "patience": "250ms", "recessional": ["hymn"]},
    {"name": "h", "designation": "machine-spirit", "auspex": {"trials": {"day": "true", "night": "false"}},
     "enact": {"*": "echo \"$SERVITOR_OMEN\""}},
  ],
  "observances": [
    {"name": "dusk", "designation": "litany", "to": ["night"], "scroll": "scrolls/dusk", "offerings": [],
     "reversion": ""},
    {"name": "hymn", "designation": "litany", "from": ["day", "void"], "scroll": "scrolls/hymn",
     "offerings": ["", "{{inscription.hour}}"], "tongue": "sh", "patience": "2m", "reversion": "echo {{former}}"},
  ],
}
