// Every form a value of pattern Mark I may take, gathered in one rite.
{
  "$schema": "https://raw.githubusercontent.com/nerdwave-nick/servitor/main/schema/rite.schema.json",
  "pattern": "Mark I",
  "purpose": "The relics of every form",
  "aspects": ["day", "night", "void"],
  "inscriptions": {
    "reason": {"purpose": "why the relics were stirred", "mandatory": false},
    "hour": {"decrees": "dawn"},
    "veil": {"mandatory": true, "decrees": {"*": "{{aspect}}"}},
    "omen": {"decrees": {}},
  },
  "auspex": {"rite": "cat ~/.cache/relics", "patience": "1.5s"},
  "tongue": "zsh",
  "liturgy": [
    {"sanctum": "~/.config/relics/a.css", "ward": "relics", "glyph": "/*", "closing-glyph": "*/",
     "scripture": ["a {", "  color: {{aspect}};", "}"]},
    {"sanctum": "~/.config/relics/b.kdl", "glyph": "//", "closing-glyph": "",
     "scripture": {"day": {"tome": "tomes/day.kdl", "illuminate": true}, "*": ""}},
    {"transcription": "~/.config/relics/c", "scripture": {"void": null, "*": ["{{aspect}}", "{{former}}"]},
     "seal": "0600", "force": true},
    {"transcription": "~/.config/relics/d", "scripture": null},
    {"transcription": "~/.config/relics/e", "scripture": {"tome": "tomes/e"}, "seal": "755", "zeal": false},
    {"tether": "~/.config/relics/f", "anchor": {"void": null, "*": "~/relics/{{aspect}}"}, "zeal": true},
    {"tether": "~/.config/relics/g", "anchor": null},
    {"incantation": {"day": "true", "*": "echo {{aspect}}"}, "tongue": "bash", "patience": "250ms",
     "reversion": {"day": "", "*": "echo {{former}}"}},
    {"vox-cast": "progress"},
    {"litany": {"night": "scrolls/dusk", "*": "scrolls/dawn"}, "offerings": [], "reversion": ""},
    {"litany": "scrolls/hymn", "offerings": ["", {"void": "-q", "*": "{{inscription.hour}}"}], "tongue": "sh",
     "patience": "2m"},
    {"vox-cast": "success"},
  ],
}
