# Forges servitor from the checkout this PKGBUILD lies in, as it stands:
#   cd packaging/arch && makepkg -si
# The exalted servitor is always /usr/bin/servitor, owned by root (spec §17.6).

pkgname=servitor
_forge=$(realpath "$startdir/../..")
# 0.7.0.r2.gf65c588 for two commits past v0.7.0. Reckoned here rather than in
# pkgver(), which would rewrite this file and leave the checkout modified.
pkgver=$(git -C "$_forge" describe --long --tags --abbrev=7 2>/dev/null |
	sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')
pkgrel=1
pkgdesc='A thrall of the Adeptus Mechanicus that performs rites upon the machine'
arch=('x86_64' 'aarch64')
url='https://github.com/nerdwave-nick/servitor'
license=('MIT')
depends=('glibc')
makedepends=('go>=2:1.27.1' 'git')
optdepends=('sudo: an intercessor for exalted verses'
	'polkit: run0 and pkexec as intercessors for exalted verses')

prepare() {
	cd "$_forge"
	export GOPATH="$srcdir/gopath" GOTOOLCHAIN=local
	go mod download -x
}

build() {
	cd "$_forge"
	export GOPATH="$srcdir/gopath" GOTOOLCHAIN=local
	export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
	export GOFLAGS='-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw'
	go build -o "$srcdir/servitor" .

	# The litanies are spoken by the forged servitor itself, upon an empty Librarium.
	local shell
	for shell in bash zsh fish; do
		SERVITOR_LIBRARIUM="$srcdir/librarium" "$srcdir/servitor" completion "$shell" >"$srcdir/completion.$shell"
	done
}

check() {
	cd "$_forge"
	export GOPATH="$srcdir/gopath" GOTOOLCHAIN=local
	export GOFLAGS='-mod=readonly -modcacherw'
	go test ./...
}

package() {
	install -Dm0755 "$srcdir/servitor" "$pkgdir/usr/bin/servitor"
	install -Dm0644 "$srcdir/completion.bash" "$pkgdir/usr/share/bash-completion/completions/servitor"
	install -Dm0644 "$srcdir/completion.zsh" "$pkgdir/usr/share/zsh/site-functions/_servitor"
	install -Dm0644 "$srcdir/completion.fish" "$pkgdir/usr/share/fish/vendor_completions.d/servitor.fish"
	install -Dm0644 "$_forge/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
